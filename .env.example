# ──────────────────────────────────────────────────────────────────────
# Primitive Onboarding – Environment Variables
# NEVER commit this file to version control.
# ──────────────────────────────────────────────────────────────────────

# ── Global ───────────────────────────────────────────────────────────
PRIMITIVE_ONBOARDING_LOG_LEVEL=DEBUG
PRIMITIVE_ONBOARDING_STATE_FILE=data/state.json

# ── Tenant Configuration ─────────────────────────────────────────────
TENANT_ACME_DOMAIN=acme.com
TENANT_ACME_ORG_NAME=Acme Corp

# ── Slack Tokens ─────────────────────────────────────────────────────
# Bot token (xoxb-)  — channel management, DMs.  Required.
TENANT_ACME_SLACK_BOT_TOKEN=xoxb-XXXXXXXXXXXXXX-XXXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXX

# Admin / user token (xoxp-)  — workspace invite via admin.users.invite.
# Optional: leave blank to skip auto-invite (users must be invited manually).
# Requires a Slack Enterprise Grid or Business+ plan.
TENANT_ACME_SLACK_ADMIN_TOKEN=

# ── Role → Channel Mapping ───────────────────────────────────────────
# Each line maps a role to one or more Slack channel IDs (comma-separated).
# Adding a new line here is the ONLY change needed to support a new role.
#
# Format: TENANT_<ID>_CHANNELS_<ROLE>=C0123456789,C0987654321
#
# Find a channel ID in Slack: right-click the channel → View channel details
# → scroll to the bottom of the About tab.
#
TENANT_ACME_CHANNELS_ENGINEERING=C0XXXXXXXXX
TENANT_ACME_CHANNELS_ADMIN=C0XXXXXXXXX
# To add a new role, just add a line like:
# TENANT_ACME_CHANNELS_MARKETING=C0123456789
